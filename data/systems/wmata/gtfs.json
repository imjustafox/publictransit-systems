{
  "static": {
    "url_secret": "WMATA_GTFS_URL",
    "auth": { "type": "header", "header": "api_key", "value_secret": "WMATA_API_KEY" },
    "route_groups": {
      "red": ["RED"],
      "blue": ["BLUE"],
      "green": ["GREEN"],
      "yellow": ["YELLOW"],
      "orange": ["ORANGE"],
      "silver": ["SILVER"]
